[req]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = dn
x509_extensions    = v3_req

[dn]
C  = PH
ST = Local
L  = Campus
O  = E-PASSPORT
CN = E-PASSPORT LAN

[v3_req]
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @alt_names

[alt_names]
DNS.1 = localhost
DNS.2 = E-PASSPORT.local
IP.1  = 127.0.0.1
IP.2  = LAN_IP_PLACEHOLDER
